# ---------------------------------------------------------------------------
# vit-social .gitignore
#
# The Next.js app lives in ./vit-social. Patterns below apply repo-wide so a
# `.next/` in the root or in a subfolder is ignored the same way.
# ---------------------------------------------------------------------------

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks

# --- Build output / framework caches ---------------------------------------
.next/
out/
build/
dist/
.turbo/
.cache/

# OpenNext (Cloudflare Worker bundle) – generated by `bun run build:cloudflare`
.open-next/

# Wrangler state / local Miniflare cache
.wrangler/

# Vercel
.vercel/

# --- Testing / coverage ----------------------------------------------------
coverage/
.nyc_output/

# --- TypeScript ------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment files -----------------------------------------------------
# Commit only .env.example; everything else is secret by default.
.env
.env.*
!.env.example

# --- Editor / IDE ----------------------------------------------------------
.idea/
.vscode/
!.vscode/settings.json.example
*.code-workspace
*.swp
*.swo

# --- OS noise --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Misc ------------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
tmp/
temp/
