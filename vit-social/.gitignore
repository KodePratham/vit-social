# App-level .gitignore.
# The root .gitignore already covers node_modules, build output, env files,
# logs, editor caches and OS junk. This file only handles anything that is
# truly specific to the Next.js app at this path.

# Generated by `next dev` / `next build`
/.next/
/out/

# OpenNext (Cloudflare) build bundle
/.open-next/

# Wrangler local cache
/.wrangler/

# TypeScript build artifacts
*.tsbuildinfo
next-env.d.ts

# Env files – commit only .env.example
.env
.env.*
!.env.example
