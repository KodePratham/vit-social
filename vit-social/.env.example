# ---------------------------------------------------------------------------
# vit-social environment template
#
# Copy this file to .env.local (never commit that file) and fill in values.
# Keys prefixed with NEXT_PUBLIC_ are inlined into the client bundle at
# build time. Everything else is server-only.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Supabase (required) - see Dashboard - Project Settings - API
# ---------------------------------------------------------------------------
# "Reference ID" (a.k.a. project ref / project id) is the subdomain in
#   https://YOUR_REFERENCE_ID.supabase.co
# Found under Project Settings - General - Reference ID. You do NOT need the
# full URL in .env unless you set NEXT_PUBLIC_SUPABASE_URL (optional).
#
# NEXT_PUBLIC_SUPABASE_PROJECT_ID is accepted as an alias for PROJECT_REF.

NEXT_PUBLIC_SUPABASE_PROJECT_REF=your_supabase_project_reference_id

# Optional: full project URL. If set, this overrides the ref / id.
# (Useful for self-hosted Supabase or a custom domain.)
# NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project_reference_id.supabase.co

# Public API key: Project Settings - API (or the "Connect" dialog).
# Prefer the Publishable key (sb_publishable_...) if your dashboard shows
# one; otherwise use the legacy "anon" / "public" JWT key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional legacy name - only set one of PUBLISHABLE_KEY or ANON_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ---------------------------------------------------------------------------
# MongoDB Atlas (required for the feed / /api/posts)
# ---------------------------------------------------------------------------
# See docs/mongodb-setup.md for an end-to-end walkthrough (Atlas cluster,
# database user, network allowlist, Cloudflare secret, etc.).
#
# MONGODB_URI is server-only - it must NEVER be prefixed with NEXT_PUBLIC_,
# and must never be committed to git. On Cloudflare use `wrangler secret put`.
# If this variable is missing, POST/GET /api/posts returns HTTP 503 and the
# feed shows an error.

# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vit_social?appName=Cluster0

# Optional database name override. Defaults to `vit_social`.
# MONGODB_DB_NAME=vit_social


# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# Google OAuth is configured in the Supabase Dashboard + Google Cloud
# Console, NOT in this .env file. See README.md - "Google sign-in" and
# googleauth.md for the step-by-step setup.
