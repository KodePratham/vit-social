# ---------------------------------------------------------------------------
# Supabase (see Dashboard: Project Settings, API)
# ---------------------------------------------------------------------------
# "Reference ID" (project ref / project id): the subdomain in
#   https://YOUR_REFERENCE_ID.supabase.co
# Location: Project Settings - General. You do not need the full URL in .env
# unless you set NEXT_PUBLIC_SUPABASE_URL (optional).
#
# You can use NEXT_PUBLIC_SUPABASE_PROJECT_ID with the same value; the app
# treats PROJECT_REF and PROJECT_ID the same.
#
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your_supabase_project_reference_id

# Optional: full project URL. If set, it overrides the project ref / id
# (for self-hosted or custom domains, use this).
# NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project_reference_id.supabase.co

# Public API key: Project Settings - API (or the Connect dialog)
# Prefer the Publishable key (sb_publishable_...) if the dashboard shows it
# or the legacy "anon" / "public" JWT key
#
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional legacy name (omit if you set PUBLISHABLE_KEY)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Google login: set up only in Supabase Dashboard and Google Cloud Console.
# No Google keys in this file. See README.md.
# ---------------------------------------------------------------------------
